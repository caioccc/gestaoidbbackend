# ------------------------------------------------------------------
# Eclésia IDB - Backend (Django) — variáveis de ambiente
# Copie este arquivo para `.env` e preencha os valores.
# Não commite o `.env` real (contém segredos).
# ------------------------------------------------------------------

# Django
SECRET_KEY=django-insecure-idb-finance-dev-key-change-in-prod-2026
DEBUG=True
ALLOWED_HOSTS=*

# URL pública do frontend (usada em links de e-mail)
FRONTEND_URL=http://localhost:3000

# Banco de dados
# Sem essa variável, django usa SQLite local (dev).
# Com Postgres (Docker/produção), informe a connection string:
#   postgres://USUARIO:SENHA@host:5432/nome_do_banco
DATABASE_URL=sqlite:///db.sqlite3
# SMTP (e-mail)
# Configuração padrão usa Gmail SMTP. Para testes sem SMTP real:
#   EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=app.noreply.ai.model@gmail.com
EMAIL_HOST_PASSWORD=kdyu eysn zsag srbq
DEFAULT_FROM_EMAIL=app.noreply.ai.model@gmail.com

